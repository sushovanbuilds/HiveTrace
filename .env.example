# PostgreSQL connection used by Prisma. These values match docker-compose.yml.
DATABASE_URL="postgresql://honychain:honychain_dev@localhost:5432/honychain?schema=public"

# Generate separate production-safe values with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-unique-secret"
QR_SECRET="replace-with-a-different-unique-secret"

# Optional local and demo configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BLOCKCHAIN_CHAIN="SIMULATED"
# Set to "true" to enable the no-database demo login bypass (demo accounts +
# the shared demo password sign in without a DB). Never enable in production.
# HIVETRACE_DEMO_LOGIN="true"
# LLM_PROVIDER="openai"
# OPENAI_API_KEY=""
# --- Google AI Studio (Gemini) ---
# LLM_PROVIDER="gemini"
# GOOGLE_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# --- OpenRouter ---
# OpenRouter serves the OpenAI chat API, so use LLM_PROVIDER="openai" and point
# OPENAI_BASE_URL at it. Any OpenRouter model id works in OPENAI_MODEL.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_MODEL="google/gemini-2.5-flash"
# --- Self-hosted model (Ollama) for the HiveOS AI advisor + attention layer ---
# Point at your Ollama server. A trycloudflare tunnel URL works, but note the
# URL changes every time the tunnel restarts — update this line when it does.
# LLM_PROVIDER="ollama"
# OLLAMA_BASE_URL="https://forming-hero-mate-ment.trycloudflare.com"
# OLLAMA_MODEL="qwen3:27b"
# OLLAMA_TIMEOUT_MS="120000"
